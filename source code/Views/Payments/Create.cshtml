@model ExcellOnServices.Models.Payment

@{
    ViewData["Title"] = "Record New Payment";
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-money-check-alt mr-2"></i>Record New Payment
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <form asp-action="CreateWithDecorator">
                        <div class="card-body" style="background-color:#271940;">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group">
                                <label asp-for="ClientId" class="control-label text-light"></label>
                                <select asp-for="ClientId" class="form-control bg-dark text-light border-dark" asp-items="ViewBag.ClientId" required>
                                    <option value="">-- Select Client --</option>
                                </select>
                                <span asp-validation-for="ClientId" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Amount" class="control-label text-light"></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-dark text-light border-dark">$</span>
                                    </div>
                                    <input asp-for="Amount"
                                           type="number"
                                           step="any"
                                           class="form-control bg-dark text-light border-dark"
                                           placeholder="0.00"
                                           required
                                           min="0"
                                           value="0.00" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger"></span>
                                <small class="form-text text-muted">Enter payment amount</small>
                            </div>

                            <!-- ========== DECORATOR PATTERN SECTION - UPDATED ========== -->
                            <div class="card mt-3" style="background-color: #1e1230; border: 1px solid #ff6b35;">
                                <div class="card-header" style="background-color: #ff6b35;">
                                    <h4 class="card-title mb-0 text-white">
                                        Additional Charges
                                    </h4>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input" id="applyCustomCharge" />
                                                    <label class="custom-control-label text-light" for="applyCustomCharge">
                                                        Apply Custom Charge
                                                    </label>
                                                </div>
                                                <div class="input-group mt-2">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text bg-dark text-light border-dark">$</span>
                                                    </div>
                                                    <input type="number" id="customChargeAmount" class="form-control bg-dark text-light border-dark" placeholder="Custom Amount" value="35" step="0.01" disabled />
                                                </div>
                                                <small class="form-text text-muted">Custom additional charge (e.g., rush fee, special handling)</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input" id="applyProcessingFee" />
                                                    <label class="custom-control-label text-light" for="applyProcessingFee">
                                                        Apply Processing Fee
                                                    </label>
                                                </div>
                                                <div class="input-group mt-2">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text bg-dark text-light border-dark">$</span>
                                                    </div>
                                                    <input type="number" id="processingFee" class="form-control bg-dark text-light border-dark" placeholder="Processing Fee Amount" value="25" step="0.01" disabled />
                                                </div>
                                                <small class="form-text text-muted">Payment gateway processing fee</small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input" id="applyTaxCharge" />
                                                    <label class="custom-control-label text-light" for="applyTaxCharge">
                                                        Apply Tax
                                                    </label>
                                                </div>
                                                <div class="input-group mt-2">
                                                    <input type="number" id="taxPercent" class="form-control bg-dark text-light border-dark" placeholder="Tax Percentage" value="5" step="0.1" disabled />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text bg-dark text-light border-dark">%</span>
                                                    </div>
                                                </div>
                                                <small class="form-text text-muted">Tax percentage on base amount</small>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <div class="custom-control custom-checkbox">
                                                    <input type="checkbox" class="custom-control-input" id="applyTip" />
                                                    <label class="custom-control-label text-light" for="applyTip">
                                                        Add Tip/Gratuity
                                                    </label>
                                                </div>
                                                <div class="input-group mt-2">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text bg-dark text-light border-dark">$</span>
                                                    </div>
                                                    <input type="number" id="tipAmount" class="form-control bg-dark text-light border-dark" placeholder="Tip Amount" value="10" step="0.01" disabled />
                                                </div>
                                                <small class="form-text text-muted">Optional tip or gratuity amount</small>
                                            </div>
                                        </div>
                                    </div>

                                    <hr style="background-color: #ff6b35;" />

                                    <div class="form-group text-center">
                                        <label class="control-label" style="font-size: 20px; color: #ff6b35; font-weight: bold;">
                                            FINAL AMOUNT:
                                        </label>
                                        <h2 id="finalAmountDisplay" style="color: #00ff00; font-weight: bold; font-size: 32px;">$0.00</h2>
                                        <input type="hidden" id="finalAmountHidden" name="DecoratedAmount" />
                                        <div id="calculationBreakdown" style="font-size: 12px; color: #888;" class="mt-2"></div>
                                        <small class="form-text text-muted">Original amount + all selected charges</small>
                                    </div>
                                </div>
                            </div>
                            <!-- ========== DECORATOR PATTERN SECTION END ========== -->

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="PaymentDate" class="control-label text-light"></label>
                                        <input asp-for="PaymentDate"
                                               class="form-control bg-dark text-light border-dark"
                                               type="date"
                                               value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                               required />
                                        <span asp-validation-for="PaymentDate" class="text-danger"></span>
                                        <small class="form-text text-muted">Date of payment</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="PaymentMethod" class="control-label text-light"></label>
                                        <select asp-for="PaymentMethod" class="form-control bg-dark text-light border-dark" required>
                                            <option value="">-- Select Method --</option>
                                            <option value="Bank Transfer">Bank Transfer</option>
                                            <option value="Credit Card">Credit Card</option>
                                            <option value="Check">Check</option>
                                            <option value="Cash">Cash</option>
                                            <option value="Online Payment">Online Payment</option>
                                        </select>
                                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                                        <small class="form-text text-muted">Payment method used</small>
                                    </div>
                                </div>
                            </div>

                            @* <div class="form-group">
                                <label asp-for="Notes" class="control-label text-light"></label>
                                <textarea asp-for="Notes" class="form-control bg-dark text-light border-dark" rows="3" placeholder="Enter payment notes (optional)"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                                <small class="form-text text-muted">Additional notes about this payment</small>
                            </div> *@
                        </div>
                        <div class="card-footer">
                            <!-- Hidden fields for decorator pattern -->
                            <input type="hidden" name="ApplyCustomCharge" id="hdnApplyCustomCharge" value="false" />
                            <input type="hidden" name="CustomChargeAmount" id="hdnCustomChargeAmount" value="0" />
                            <input type="hidden" name="ApplyProcessingFee" id="hdnApplyProcessingFee" value="false" />
                            <input type="hidden" name="ProcessingFee" id="hdnProcessingFee" value="0" />
                            <input type="hidden" name="ApplyTaxCharge" id="hdnApplyTaxCharge" value="false" />
                            <input type="hidden" name="TaxPercent" id="hdnTaxPercent" value="0" />
                            <input type="hidden" name="ApplyTip" id="hdnApplyTip" value="false" />
                            <input type="hidden" name="TipAmount" id="hdnTipAmount" value="0" />

                            <button type="submit" class="btn btn-primary">
                                Record Payment
                            </button>
                            <a asp-action="Index" class="btn btn-default ml-2">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-info">
                    <div class="card-header">
                        <h3 class="card-title">Payment Information</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body" style="background-color:#271940;">
                        <p class="text-light"><strong>Available Fee Options:</strong></p>
                        <ul class="mb-3 text-light">
                            <li><strong>Custom Charge:</strong> Custom additional charge (rush fee, special handling, etc.)</li>
                            <li><strong>Processing Fee:</strong> Payment gateway processing fee</li>
                            <li><strong>Tax:</strong> Tax percentage on base amount</li>
                            <li><strong>Tip/Gratuity:</strong> Optional tip amount</li>
                        </ul>
                        <div class="alert alert-success">
                            <i class="icon fas fa-money-bill-wave"></i>
                            <strong>Payment Calculation:</strong><br>
                            Total = Base Amount + All Selected Fees + Tax
                        </div>
                        <p class="text-light small">
                            <strong>Example Calculation:</strong>
                        </p>
                        <div class="bg-dark p-2 rounded mb-3">
                            <p class="mb-1 text-light small">
                                <strong>Base Amount: $1,000</strong><br>
                                + Custom Charge: $35<br>
                                + Processing Fee: $25<br>
                                + Tax (5%): $50<br>
                                + Tip: $10<br>
                                = <strong class="text-success">$1,120.00</strong>
                            </p>
                        </div>
                        <p class="text-muted small">
                            Track all client payments here for accounting and reporting purposes.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Set default date for PaymentDate
        document.addEventListener('DOMContentLoaded', function () {
            console.log('Payment Create page loaded');

            const paymentDateInput = document.querySelector('input[name="PaymentDate"]');
            if (paymentDateInput && !paymentDateInput.value) {
                paymentDateInput.value = new Date().toISOString().split('T')[0];
                console.log('Set default PaymentDate:', paymentDateInput.value);
            }

            // Format amount input
            const amountInput = document.querySelector('input[name="Amount"]');
            if (amountInput) {
                amountInput.addEventListener('blur', function () {
                    if (this.value && !isNaN(this.value)) {
                        this.value = parseFloat(this.value).toFixed(2);
                        console.log('Formatted amount:', this.value);
                    }
                });
            }
        });

        // ========== DECORATOR PATTERN CALCULATION ==========
        function calculateFinalAmount() {
            // Get original amount
            let amountInput = document.querySelector('input[name="Amount"]');
            let originalAmount = parseFloat(amountInput?.value) || 0;
            let finalAmount = originalAmount;
            let breakdown = [`Base Amount: $${originalAmount.toFixed(2)}`];

            // Get checkbox states
            let applyCustomCharge = document.getElementById('applyCustomCharge')?.checked || false;
            let applyProcessingFee = document.getElementById('applyProcessingFee')?.checked || false;
            let applyTaxCharge = document.getElementById('applyTaxCharge')?.checked || false;
            let applyTip = document.getElementById('applyTip')?.checked || false;

            // Get fee values
            let customChargeAmount = parseFloat(document.getElementById('customChargeAmount')?.value) || 0;
            let processingFee = parseFloat(document.getElementById('processingFee')?.value) || 0;
            let taxPercent = parseFloat(document.getElementById('taxPercent')?.value) || 0;
            let tipAmount = parseFloat(document.getElementById('tipAmount')?.value) || 0;

            // Apply custom charge decorator
            if (applyCustomCharge && customChargeAmount > 0) {
                finalAmount += customChargeAmount;
                breakdown.push(`+ Custom Charge: $${customChargeAmount.toFixed(2)}`);
            }

            // Apply processing fee decorator
            if (applyProcessingFee && processingFee > 0) {
                finalAmount += processingFee;
                breakdown.push(`+ Processing Fee: $${processingFee.toFixed(2)}`);
            }

            // Apply tax charge (percentage on original amount)
            if (applyTaxCharge && taxPercent > 0) {
                let taxAmount = originalAmount * (taxPercent / 100);
                finalAmount += taxAmount;
                breakdown.push(`+ Tax (${taxPercent}%): $${taxAmount.toFixed(2)}`);
            }

            // Apply tip/gratuity
            if (applyTip && tipAmount > 0) {
                finalAmount += tipAmount;
                breakdown.push(`+ Tip/Gratuity: $${tipAmount.toFixed(2)}`);
            }

            // Update display
            document.getElementById('finalAmountDisplay').innerHTML = '$' + finalAmount.toFixed(2);
            document.getElementById('finalAmountHidden').value = finalAmount;

            // Show calculation breakdown
            if (breakdown.length > 1) {
                document.getElementById('calculationBreakdown').innerHTML = breakdown.join(' → ') + ` = <strong>$${finalAmount.toFixed(2)}</strong>`;
            } else {
                document.getElementById('calculationBreakdown').innerHTML = 'No additional charges selected';
            }

            // Update hidden fields for form submission
            document.getElementById('hdnApplyCustomCharge').value = applyCustomCharge ? 'true' : 'false';
            document.getElementById('hdnCustomChargeAmount').value = customChargeAmount;
            document.getElementById('hdnApplyProcessingFee').value = applyProcessingFee ? 'true' : 'false';
            document.getElementById('hdnProcessingFee').value = processingFee;
            document.getElementById('hdnApplyTaxCharge').value = applyTaxCharge ? 'true' : 'false';
            document.getElementById('hdnTaxPercent').value = taxPercent;
            document.getElementById('hdnApplyTip').value = applyTip ? 'true' : 'false';
            document.getElementById('hdnTipAmount').value = tipAmount;

            console.log(`Original: $${originalAmount}, Final: $${finalAmount}`);
            return finalAmount;
        }

        // Enable/disable inputs when checkbox changes
        document.getElementById('applyCustomCharge')?.addEventListener('change', function () {
            document.getElementById('customChargeAmount').disabled = !this.checked;
            calculateFinalAmount();
        });

        document.getElementById('applyProcessingFee')?.addEventListener('change', function () {
            document.getElementById('processingFee').disabled = !this.checked;
            calculateFinalAmount();
        });

        document.getElementById('applyTaxCharge')?.addEventListener('change', function () {
            document.getElementById('taxPercent').disabled = !this.checked;
            calculateFinalAmount();
        });

        document.getElementById('applyTip')?.addEventListener('change', function () {
            document.getElementById('tipAmount').disabled = !this.checked;
            calculateFinalAmount();
        });

        // Listen to amount changes
        let amountInput = document.querySelector('input[name="Amount"]');
        if (amountInput) {
            amountInput.addEventListener('input', function () {
                if (this.value && !isNaN(this.value)) {
                    this.value = parseFloat(this.value).toFixed(2);
                }
                calculateFinalAmount();
            });
        }

        // Listen to fee value changes
        document.getElementById('customChargeAmount')?.addEventListener('input', calculateFinalAmount);
        document.getElementById('processingFee')?.addEventListener('input', calculateFinalAmount);
        document.getElementById('taxPercent')?.addEventListener('input', calculateFinalAmount);
        document.getElementById('tipAmount')?.addEventListener('input', calculateFinalAmount);

        // Override form submission to use decorated amount
        document.querySelector('form')?.addEventListener('submit', function (e) {
            let finalAmount = calculateFinalAmount();
            let amountInput = document.querySelector('input[name="Amount"]');

            // Replace original amount with decorated amount
            if (amountInput) {
                amountInput.value = finalAmount.toFixed(2);
                console.log(`Form submitting with decorated amount: $${finalAmount}`);
            }
        });
    </script>
}